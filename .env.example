# Copy to .env and adjust. docker compose reads it automatically.

# Host port nginx (the only public entry point) is published on.
HTTP_PORT=8080

# Interface to bind. 0.0.0.0 = all interfaces, 127.0.0.1 = this machine only.
BIND_ADDR=0.0.0.0

# Comma-separated browser origins the API will accept. Match your public URL.
CORS_ORIGINS=http://localhost:8080
